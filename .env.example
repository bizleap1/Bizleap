# Google PageSpeed Insights API v5 key (server-side only, used by /api/seo-audit)
PAGESPEED_API_KEY=your_google_pagespeed_api_key_here

# Webhook URL for saving Free SEO Audit leads (e.g. Google Apps Script Web App URL)
LEADS_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec

# Shared secret sent in the JSON payload to LEADS_WEBHOOK_URL
LEADS_WEBHOOK_SECRET=your_webhook_secret_here

# Gemini API key (server-side only, used by /api/chat)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase database (optional but recommended for permanent cloud storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
